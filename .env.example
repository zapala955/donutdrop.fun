# English-only backend configuration. Copy to .env for local development only.
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
DATABASE_URL=postgresql://donut:change-me@127.0.0.1:5432/donut_upgrader
DATABASE_SSL=false
REDIS_URL=
APP_ORIGIN=http://localhost:3000
COOKIE_SECRET=development-cookie-secret-change-before-production-0001
DATA_ENCRYPTION_KEY=AQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQE=
BOT_CREDENTIALS_JSON={"00000000-0000-4000-8000-000000000001":{"secret":"AgICAgICAgICAgICAgICAgICAgICAgICAgICAgICAgICAgI=","serverHost":"donutsmp.net","username":"DonutBot"}}
ADMIN_TOTP_SECRETS_JSON={}
AUDIT_LOG_HMAC_KEY=development-audit-secret-change-before-production-0001
AUDIT_LOG_KEY_ID=dev-v1
IP_HASH_KEY=development-ip-hash-secret-change-before-production-0001
ADMIN_MINECRAFT_IDS=
ALLOWED_COUNTRIES=PL
SESSION_TTL_HOURS=24
HOUSE_EDGE_BPS=500
MIN_MULTIPLIER_BPS=11000
MAX_MULTIPLIER_BPS=1000000
MAX_WIN_CHANCE_PPM=750000
MAX_DAILY_WAGER_MINOR=10000000
MINECRAFT_TRANSFERS_ENABLED=false
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
LOG_LEVEL=info

# Mineflayer worker. BOT_WEBHOOK_SECRET must match this BOT_ID's API credential.
MINECRAFT_HOST=donutsmp.net
MINECRAFT_PORT=25565
MINECRAFT_VERSION=false
MINECRAFT_AUTH=microsoft
MINECRAFT_USERNAME=bot-account@example.com
MINECRAFT_EXPECTED_USERNAME=DonutBot
MINECRAFT_PROFILES_FOLDER=/run/secrets/minecraft-auth
BOT_ID=00000000-0000-4000-8000-000000000001
BOT_WEBHOOK_SECRET=AgICAgICAgICAgICAgICAgICAgICAgICAgICAgICAgICAgI=
API_INTERNAL_URL=http://127.0.0.1:3001/internal/v1/minecraft
BOT_POLL_INTERVAL_MS=2000
BOT_TRANSFERS_ENABLED=false

# Docker Compose reads secrets from ignored files and mounts only what each service needs.
POSTGRES_SUPERUSER_PASSWORD_FILE=../../.secrets/postgres-superuser-password
POSTGRES_MIGRATOR_PASSWORD_FILE=../../.secrets/postgres-migrator-password
POSTGRES_RUNTIME_PASSWORD_FILE=../../.secrets/postgres-runtime-password
POSTGRES_AUDIT_PASSWORD_FILE=../../.secrets/postgres-audit-password
MIGRATION_DATABASE_URL_FILE=../../.secrets/migration-database-url
API_DATABASE_URL_FILE=../../.secrets/api-database-url
AUDIT_DATABASE_URL_FILE=../../.secrets/audit-database-url
REDIS_CONFIG_FILE=../../.secrets/redis.conf
API_REDIS_URL_FILE=../../.secrets/api-redis-url
API_COOKIE_SECRET_FILE=../../.secrets/api-cookie-secret
API_DATA_ENCRYPTION_KEY_FILE=../../.secrets/api-data-encryption-key
API_BOT_CREDENTIALS_JSON_FILE=../../.secrets/api-bot-credentials.json
API_ADMIN_TOTP_SECRETS_JSON_FILE=../../.secrets/api-admin-totp-secrets.json
API_AUDIT_HMAC_KEY_FILE=../../.secrets/api-audit-hmac-key
API_IP_HASH_KEY_FILE=../../.secrets/api-ip-hash-key
AUDIT_VERIFICATION_KEYS_JSON_FILE=../../.secrets/audit-verification-keys.json
AUDIT_CHECKPOINT_HMAC_KEY_FILE=../../.secrets/audit-checkpoint-hmac-key
AUDIT_CHECKPOINT_KEY_ID=checkpoint-v1
BOT_WEBHOOK_SECRET_FILE=../../.secrets/bot-webhook-secret
BOT_AUTH_DIRECTORY=../../.secrets/minecraft-auth
EDGE_NETWORK_CIDR=172.30.0.0/24
DATABASE_NETWORK_CIDR=172.31.0.0/24
CACHE_NETWORK_CIDR=172.34.0.0/24
BOT_CONTROL_NETWORK_CIDR=172.32.0.0/24
BOT_EGRESS_NETWORK_CIDR=172.33.0.0/24
