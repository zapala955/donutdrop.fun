# English-only backend configuration. Copy to .env for local development only.
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
DATABASE_URL=postgresql://donut:change-me@127.0.0.1:5432/donut_upgrader
DATABASE_SSL=false
REDIS_URL=
APP_ORIGIN=http://localhost:3000
COOKIE_SECRET=development-cookie-secret-change-before-production-0001
DATA_ENCRYPTION_KEY=AQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQE=
BOT_CREDENTIALS_JSON={"00000000-0000-4000-8000-000000000001":{"secret":"AgICAgICAgICAgICAgICAgICAgICAgICAgICAgICAgICAgI=","serverHost":"donutsmp.net","username":"DonutBot"}}
ADMIN_TOTP_SECRETS_JSON={}
AUDIT_LOG_HMAC_KEY=development-audit-secret-change-before-production-0001
AUDIT_LOG_KEY_ID=dev-v1
IP_HASH_KEY=development-ip-hash-secret-change-before-production-0001
ADMIN_MINECRAFT_IDS=
SESSION_TTL_HOURS=24
HOUSE_EDGE_BPS=1000
ITEM_SELL_RATE_BPS=9000
MIN_MULTIPLIER_BPS=11000
MAX_MULTIPLIER_BPS=1000000
MAX_WIN_CHANCE_PPM=750000
ROULETTE_ENABLED=true
ROULETTE_ROUND_SECONDS=10
ROULETTE_SPIN_SECONDS=3
ROULETTE_MIN_STAKE_MINOR=100000
ROULETTE_MAX_STAKE_MINOR=1000000000
# The table limit: everything one player may have riding on a single spin, across every chip. The
# per-chip cap above is not a limit on its own - a player can simply place it again - so this is
# the ceiling that actually bounds a round. It must be at least ROULETTE_MAX_STAKE_MINOR or the
# API refuses to start, because a first chip at the advertised maximum would otherwise be rejected
# by a ceiling nobody was shown.
#
# It bounds STAKE, not house exposure. $5B across red and black is a player risking almost
# nothing; $5B on a single number is a $166B liability at a 10% edge. Read it beside the
# per-pocket liability table in the admin console rather than instead of it.
ROULETTE_MAX_ROUND_STAKE_MINOR=5000000000

# Vault yield. Items left untouched in the vault accrue a daily percentage of their fixed
# catalog price, paid out as cash. The cap is the lifetime ceiling per lot and is what stops
# a holding incentive from becoming an inflation pump - it is refused if a rate is set without it.
VAULT_YIELD_BPS_PER_DAY=100
VAULT_YIELD_CAP_BPS=3000

MINECRAFT_TRANSFERS_ENABLED=false
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
LOG_LEVEL=info

# Mineflayer worker. BOT_WEBHOOK_SECRET must match this BOT_ID's API credential.
MINECRAFT_HOST=donutsmp.net
MINECRAFT_PORT=25565
MINECRAFT_VERSION=false
MINECRAFT_AUTH=microsoft
MINECRAFT_USERNAME=bot-account@example.com
MINECRAFT_EXPECTED_USERNAME=DonutBot
MINECRAFT_PROFILES_FOLDER=/run/secrets/minecraft-auth
BOT_ID=00000000-0000-4000-8000-000000000001
BOT_WEBHOOK_SECRET=AgICAgICAgICAgICAgICAgICAgICAgICAgICAgICAgICAgI=
API_INTERNAL_URL=http://127.0.0.1:3001/internal/v1/minecraft
BOT_POLL_INTERVAL_MS=2000
BOT_TRANSFERS_ENABLED=false

# Docker Compose reads secrets from ignored files and mounts only what each service needs.
POSTGRES_SUPERUSER_PASSWORD_FILE=../../.secrets/postgres-superuser-password
POSTGRES_MIGRATOR_PASSWORD_FILE=../../.secrets/postgres-migrator-password
POSTGRES_RUNTIME_PASSWORD_FILE=../../.secrets/postgres-runtime-password
POSTGRES_AUDIT_PASSWORD_FILE=../../.secrets/postgres-audit-password
POSTGRES_WAL_ARCHIVE_DIRECTORY=../../.wal-archive
MIGRATION_DATABASE_URL_FILE=../../.secrets/migration-database-url
API_DATABASE_URL_FILE=../../.secrets/api-database-url
AUDIT_DATABASE_URL_FILE=../../.secrets/audit-database-url
REDIS_CONFIG_FILE=../../.secrets/redis.conf
API_REDIS_URL_FILE=../../.secrets/api-redis-url
API_COOKIE_SECRET_FILE=../../.secrets/api-cookie-secret
API_DATA_ENCRYPTION_KEY_FILE=../../.secrets/api-data-encryption-key
API_BOT_CREDENTIALS_JSON_FILE=../../.secrets/api-bot-credentials.json
API_ADMIN_TOTP_SECRETS_JSON_FILE=../../.secrets/api-admin-totp-secrets.json
API_AUDIT_HMAC_KEY_FILE=../../.secrets/api-audit-hmac-key
API_IP_HASH_KEY_FILE=../../.secrets/api-ip-hash-key
API_DONUTSMP_API_KEY_FILE=../../.secrets/api-donutsmp-api-key
AUDIT_VERIFICATION_KEYS_JSON_FILE=../../.secrets/audit-verification-keys.json
AUDIT_CHECKPOINT_HMAC_KEY_FILE=../../.secrets/audit-checkpoint-hmac-key
AUDIT_CHECKPOINT_KEY_ID=checkpoint-v1
BOT_WEBHOOK_SECRET_FILE=../../.secrets/bot-webhook-secret
BOT_AUTH_DIRECTORY=../../.secrets/minecraft-auth
EDGE_NETWORK_CIDR=172.30.0.0/24
DATABASE_NETWORK_CIDR=172.31.0.0/24
CACHE_NETWORK_CIDR=172.34.0.0/24
BOT_CONTROL_NETWORK_CIDR=172.32.0.0/24
BOT_EGRESS_NETWORK_CIDR=172.33.0.0/24
API_EGRESS_NETWORK_CIDR=172.36.0.0/24

# DonutSMP Public API. Exact balances; chat amounts are abbreviated above 999 and cannot be trusted.
# Rate limit is 250 requests per minute per key. Create in game with /api.
DONUTSMP_API_BASE_URL=https://api.donutsmp.net
DONUTSMP_API_KEY=replace-with-your-donutsmp-api-key

# Website-only items: the bot custodies nothing for players, so its real Minecraft
# inventory must not reconcile against the ledger or quarantine the bot.
PHYSICAL_CUSTODY_ENABLED=false

# Developer login. Mints a session for a disposable test account with no custody bot online, so
# the site can be exercised locally. This is an AUTHENTICATION BYPASS: the API refuses to start
# if it is enabled with NODE_ENV=production, the route is not registered when it is off, and the
# request must carry the token below. Never expose a server running this to the internet.
DEV_LOGIN_ENABLED=false
DEV_LOGIN_TOKEN=replace-with-32-random-characters
DEV_LOGIN_BALANCE_MINOR=50000000

# Website-only stock. When on, the house never runs out: an award mints the item instead of
# consuming a lot the bot holds, and the catalogue reports every enabled item as available.
# Mutually exclusive with PHYSICAL_CUSTODY_ENABLED - the API refuses to start with both set,
# because minting items no bot is holding would break reconciliation permanently.
HOUSE_STOCK_UNLIMITED=false

# Chat. Slow mode is the per-user spacing between messages, enforced server-side against the
# database rather than by a disabled button. CHAT_BIG_HIT_MINOR is the payout at or above which a
# win is announced in chat; everything below it still appears in the live ticker.
CHAT_ENABLED=true
CHAT_SLOW_MODE_SECONDS=5
CHAT_BIG_HIT_MINOR=50000000

# Daily reward streak. A player must wager $10M during the current UTC day before that day's
# reward can be claimed. The API enforces this against the append-only wager log; the browser only
# displays the resulting progress.
STREAK_BASE_REWARD_MINOR=25000
STREAK_MAX_MULTIPLIER=7
# 0 disables the gate entirely, which is the default. Runtime-manageable from the console.
STREAK_DAILY_WAGER_REQUIRED_MINOR=0

# Referrals. Two engines run on one relationship and both are paid out of the house margin, so a
# referred player never pays more or wins less because somebody invited them.
#
#   REFERRAL_REVSHARE_BPS       the referrer's claimable lifetime cut of the margin the referee's
#                               wagers earn the house. 500 = 5% of margin, NOT 5% of the wager.
#   REFERRAL_BONUS_MINOR        the one-off bonus, paid once per referee, ever.
#   REFERRAL_BONUS_WAGER_MINOR  cumulative wager the referee must reach before it unlocks.
#
# ONE CONDITION: the referee's cumulative wager reaches REFERRAL_BONUS_WAGER_MINOR. Paid once per
# referee, ever - the unique index on (kind, reference_id) makes a second payment for the same
# referral impossible rather than merely unreachable.
#
# WHAT A REFERRER GETS, AND HOW TO READ THE TWO RATES
#
#   REFERRAL_BONUS_MINOR        $10,000,000, once, at $100,000,000 wagered.
#   REFERRAL_REVSHARE_BPS       500 = 5% OF THE HOUSE MARGIN, which at HOUSE_EDGE_BPS=1000 is
#                               exactly 0.5% OF THE WAGER. That is the figure players are quoted.
#
# The revenue share is priced off the margin and not off turnover, like every other payout here, so
# that their sum can be checked against the one edge that funds all of them. The 0.5%-of-wager
# figure is a CONSEQUENCE of a 10% edge, not a setting: halve the edge and the same 500 bps pays
# 0.25% of wager. Whoever changes HOUSE_EDGE_BPS is changing what referrers earn.
#
# THE ARITHMETIC, AT THE CURRENT DEFAULTS
#
#   Referee wagers        $100,000,000
#   House margin earned    $10,000,000   (10% edge)
#   Bonus paid             $10,000,000
#   Revenue share earned      $500,000   (0.5% of wager, claimed from Rewards)
#   Net at unlock            -$500,000
#
# So an invite is half a million down at the moment it pays, and covers itself once that referee
# has wagered about $110,000,000 lifetime. That is a deliberate growth cost and a modest one.
#
# SELF-REFERRAL. Nothing requires a referee to be a different person any more - Discord
# verification used to make a fabricated referee cost something and is no longer part of the gate.
# Someone running both accounts wagers $100M, loses $10M to the edge, and collects $10.5M: about
# $500,000 ahead, for churning a hundred million through the site. It is thin enough not to be
# worth automating, which is a property of the 10% edge rather than of any check. Break-even sits
# at REFERRAL_BONUS_MINOR = REFERRAL_BONUS_WAGER_MINOR * HOUSE_EDGE_BPS / 10000; going further and
# making self-referral actually unprofitable means raising the threshold above that.
#
# The API still refuses to start if the bonus exceeds the wager that unlocks it. That is a floor
# against nonsense, not a solvency guarantee - how much to spend acquiring a player is a decision,
# not a bug.
#
# Players may choose their own code (PUT /v1/referrals/code). A rename carries existing referrals
# with it through ON UPDATE CASCADE, so links already in the wild keep working, and codes
# containing ADMIN, DONUT, STAFF, SUPPORT and similar are refused because a code sits next to this
# site's name in public chat.
REFERRALS_ENABLED=true
REFERRAL_REVSHARE_BPS=500
REFERRAL_BONUS_MINOR=10000000
REFERRAL_BONUS_WAGER_MINOR=100000000

# Discord OAuth, used only to prove that a referee controls a unique Discord account. The scope
# requested is `identify` and nothing else, the access token is used once and never stored, and
# one Discord account can verify exactly one site account - that uniqueness is the only thing
# standing between a per-referee bonus and a faucet.
#
# DISCORD_REDIRECT_URI must match the redirect registered on the Discord application exactly, and
# it points at this API, not at the frontend:
#   https://api.example.com/v1/referrals/discord/callback
# The callback redirects the browser back to APP_ORIGIN/referrals when it is done.
#
# DISCORD_CLIENT_SECRET supports the _FILE indirection like every other credential here.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=

# ---------------------------------------------------------------------------
# The Discord control plane
# ---------------------------------------------------------------------------
# A private guild becomes a remote control for the platform: read commands, moderation commands,
# and a command that mints a single-use link into the admin dashboard.
#
# READ THIS BEFORE TURNING IT ON.
#
# A redeemed dashboard link produces an administrator session with MFA already marked satisfied.
# Everywhere else on this platform an admin session requires the TOTP secret from
# ADMIN_TOTP_SECRETS_JSON, re-checked on every single request, so holding the session cookie is not
# enough. This is the one path that does not ask.
#
# The consequence is simple and worth saying out loud: whoever controls the operator's Discord
# account controls the platform. Discord's own account security becomes your admin account
# security. Enable this only with 2FA on every operator's Discord account, and treat the bot token
# as seriously as a database password.
#
# If that trade stops looking worth it, the schema already supports the alternative: links minted
# with `require_totp` produce a session that still has to pass the normal TOTP step.
DISCORD_CONTROL_ENABLED=false

# The bot's own credential. Anyone holding it can act as the application. Supports _FILE.
DISCORD_BOT_TOKEN=

# The application id, and the ONE guild these commands are published to and accepted from. The
# guild is pinned rather than optional: without it, anyone who can invite the bot to a server of
# their own gets a console pointed at production.
DISCORD_APPLICATION_ID=
DISCORD_GUILD_ID=

# Shared HMAC key between the bot process and the gateway; every request the bot makes is signed
# with it. At least 32 characters. Generate with: openssl rand -base64 48. Supports _FILE.
DISCORD_CONTROL_HMAC_KEY=

# Who may use the commands: Discord snowflake -> platform admin identity. Every identity here must
# ALSO appear in ADMIN_MINECRAFT_IDS or the gateway refuses to boot, so removing an administrator
# in one place cannot leave a door open in the other. Supports _FILE.
#   {"123456789012345678":"mc:0123456789abcdef0123456789abcdef"}
DISCORD_OPERATORS_JSON={}

# Where operational alerts are posted (rising quarantines, dead-letter jobs, withdrawals stuck in
# manual review). Outbound only; the bot never reads this channel. Empty disables the feed.
DISCORD_ALERT_CHANNEL_ID=

# How long a minted dashboard link stays redeemable. Capped at 900 seconds by the schema, because
# this is the window in which a leaked URL is worth something. Shorter is better.
DISCORD_ADMIN_LINK_TTL_SECONDS=300

# Per-operator command budget, enforced in Postgres so it survives a bot restart.
DISCORD_COMMAND_RATE_LIMIT=30
DISCORD_COMMAND_RATE_WINDOW_SECONDS=60

# How long a destructive command's confirmation stays valid before it must be re-issued.
DISCORD_CONFIRM_TTL_SECONDS=120

# Read by the bot process only (services/discord-bot). It must be able to reach the gateway's
# /internal/ routes, which should not be exposed publicly.
API_INTERNAL_BASE_URL=http://localhost:3001
ALERT_POLL_SECONDS=60

# Rakeback. Four tiers on four clocks: instant has no cooldown, then daily, weekly and monthly.
#
# EVERY RATE IS A SHARE OF THE HOUSE MARGIN, NOT OF TURNOVER. The edge is 5%, so a "10% instant
# rakeback" priced off the wager would return twice what the wager earned the house and the game
# would run at a loss. Priced off the margin, the four tiers together give back 20% of the edge.
# The API refuses to start if they sum above 10000 bps, because they all come out of one pot.
RAKEBACK_ENABLED=false
RAKEBACK_INSTANT_BPS=1000

# Wagering races. A timed leaderboard with a fixed pool, settled by rank against a payout curve
# stored on the race itself - so the split a player was shown while competing is the split they
# are paid. Races are created by an operator (INSERT into wager_races with a payout_curve of
# basis points, highest rank first, summing to at most 10000). Entry is automatic: every wager
# counts toward every live race, so a daily and a weekly can run at the same time.
#
# RACE_LEADERBOARD_SIZE is how many rows the board shows, which is independent of how many places
# the curve actually pays.
RACES_ENABLED=false
RACE_LEADERBOARD_SIZE=50

# Creator programme. An application for a vanity referral code at a boosted revenue share, again
# carved from the house margin. Applications are reviewed rather than self-serve, because a rate
# anybody can grant themselves is not a rate. CREATOR_MAX_REVSHARE_BPS is the ceiling an approval
# may grant; the default programme rate is REFERRAL_REVSHARE_BPS above.
CREATOR_PROGRAMME_ENABLED=false
CREATOR_MAX_REVSHARE_BPS=2000

# ──────────────────────────────────────────────────────────────────────────────────────────────
# 1v1 SKILL DUELS
# ──────────────────────────────────────────────────────────────────────────────────────────────
# The only mode on the platform with NO house edge on the outcome. The house does not hold a side
# and cannot lose, so it takes 0% of the result; its revenue is a rake on the pot of a duel it
# actually DECIDED. A draw, an abandoned lobby or an expiry refunds both stakes whole and the
# house is paid nothing.
#
#   SKILL_DUEL_RAKE_BPS     the fee, in basis points of the POT. 300 = 3%.
#                           Worked example: both players stake $50M, pot is $100M, the house keeps
#                           $3M and the winner is credited $97M.
#                           Snapshot onto each lobby row at creation, so changing it here never
#                           changes the fee on a duel that is already on the board.
#   SKILL_DUEL_MIN/MAX_STAKE_MINOR   the per-player stake band.
#   SKILL_DUEL_LOBBY_TTL_MINUTES     how long an unjoined lobby holds its host's stake.
#
# TWO THINGS THE API REFUSES TO BOOT WITH:
#   1. A rake at or below 200 bps while VIP_ENABLED is on. The VIP ceiling is 2.00% OF WAGER and
#      is the largest single claim on a duel's margin — a thinner rake pays out more rakeback than
#      the duel collected. Note this mode becomes the SMALLEST edge on the platform at the default
#      300 bps against the upgrader's 500, which is why it gets its own check.
#   2. A minimum stake so small that `pot * rake_bps / 10000` truncates to zero. The rake rounds
#      in the player's favour by design, so a low enough floor means the house runs those duels
#      for free and still accrues rakeback on them.
SKILL_DUEL_ENABLED=false
SKILL_DUEL_RAKE_BPS=300
SKILL_DUEL_MIN_STAKE_MINOR=100000
SKILL_DUEL_MAX_STAKE_MINOR=10000000000
SKILL_DUEL_LOBBY_TTL_MINUTES=15


# VIP levels. Thirty sub-levels across six tiers, and the only thing a level grants is a rakeback
# rate. A player's level is derived from lifetime wagered volume and is never stored, so there is
# no cached rank to go stale.
#
# THE VIP RATE IS A PERCENTAGE OF WAGER. RAKEBACK_INSTANT_BPS above is a percentage of
# the house MARGIN. They share a ledger and a claim path but not a base:
#
#   VIP at the 2.00% ceiling   = 2.00% of wager = 20% of a 10% crate margin
#   RAKEBACK_INSTANT_BPS=1000  = 10% of margin  =  0.5% of wager at a 5% edge
#
# The ceiling is fixed in code at 2.00% because the whole 0.10%-to-2.00% scale was solved against
# it; what is configurable here is only whether the programme runs.
#
# The API refuses to boot if the VIP ceiling plus the tier rakebacks plus the referral share could
# meet or exceed the house edge they are all paid from. That check runs against the SMALLEST edge
# on the platform - the upgrader's HOUSE_EDGE_BPS, not the crate edge - because that is the one
# that decides solvency.
VIP_ENABLED=false
