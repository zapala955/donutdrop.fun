# Root-owned mode-0600 file installed as /opt/donutdrop/shared/backup.env.
# Restic encrypts every repository. Use an off-VPS repository, for example s3:s3.example/bucket/path.
RESTIC_REPOSITORY=s3:s3.example.invalid/donutdrop-production
RESTIC_PASSWORD_FILE=/opt/donutdrop/shared/secrets/restic-password

# Provider credentials belong here or in a root-only systemd EnvironmentFile, never in the repo.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
