# Copy to /opt/donutdrop/shared/donutdrop.env on the VPS. This file contains no secrets.
# Secret values live in one-line files under /opt/donutdrop/shared/secrets.

APP_ORIGIN=https://donutdrop.fun
ALLOWED_COUNTRIES=PL
GAME_CURRENCY_ONLY=true
AUDIT_LOG_KEY_ID=prod-v1
AUDIT_CHECKPOINT_KEY_ID=checkpoint-v1
LOG_LEVEL=info
BOT_LOG_LEVEL=info

# Replace these three values with the dedicated DonutSMP bot account.
BOT_ID=00000000-0000-4000-8000-000000000001
MINECRAFT_USERNAME=bot-account@example.com
MINECRAFT_EXPECTED_USERNAME=DonutBot
MINECRAFT_HOST=donutsmp.net
MINECRAFT_PORT=25565
MINECRAFT_VERSION=false
BOT_POLL_INTERVAL_MS=2000

# Cash-only is the safe mode while the bundled Minecraft transfer adapter remains disabled.
# The process refuses to enable physical transfers in production.
MINECRAFT_TRANSFERS_ENABLED=false
BOT_TRANSFERS_ENABLED=false
PHYSICAL_CUSTODY_ENABLED=false
HOUSE_STOCK_UNLIMITED=true
CASH_ONLY_PLAY=true

# Core economy settings. Optional programmes remain off until reviewed and funded.
HOUSE_EDGE_BPS=500
ITEM_SELL_RATE_BPS=9000
MIN_MULTIPLIER_BPS=11000
MAX_MULTIPLIER_BPS=1000000
MAX_WIN_CHANCE_PPM=750000
SESSION_TTL_HOURS=24
CHAT_ENABLED=true
PIGGY_BANK_ENABLED=false
VIP_ENABLED=false
RAKEBACK_ENABLED=false
REFERRALS_ENABLED=false
SKILL_DUEL_ENABLED=false
SLITHER_ARENA_ENABLED=false
VAULT_JACKPOT_ENABLED=false
LAVA_RAIN_ENABLED=false
TIPS_ENABLED=false
SIDE_BETS_ENABLED=false
RACES_ENABLED=false
CREATOR_PROGRAMME_ENABLED=false

DONUTSMP_API_BASE_URL=https://api.donutsmp.net
PAY_LOGIN_MIN_AMOUNT=100
PAY_LOGIN_MAX_AMOUNT=999

POSTGRES_SUPERUSER_PASSWORD_FILE=/opt/donutdrop/shared/secrets/postgres-superuser-password
POSTGRES_MIGRATOR_PASSWORD_FILE=/opt/donutdrop/shared/secrets/postgres-migrator-password
POSTGRES_RUNTIME_PASSWORD_FILE=/opt/donutdrop/shared/secrets/postgres-runtime-password
POSTGRES_AUDIT_PASSWORD_FILE=/opt/donutdrop/shared/secrets/postgres-audit-password
MIGRATION_DATABASE_URL_FILE=/opt/donutdrop/shared/secrets/migration-database-url
API_DATABASE_URL_FILE=/opt/donutdrop/shared/secrets/api-database-url
AUDIT_DATABASE_URL_FILE=/opt/donutdrop/shared/secrets/audit-database-url
REDIS_CONFIG_FILE=/opt/donutdrop/shared/secrets/redis.conf
API_REDIS_URL_FILE=/opt/donutdrop/shared/secrets/api-redis-url
API_COOKIE_SECRET_FILE=/opt/donutdrop/shared/secrets/api-cookie-secret
API_DATA_ENCRYPTION_KEY_FILE=/opt/donutdrop/shared/secrets/api-data-encryption-key
API_BOT_CREDENTIALS_JSON_FILE=/opt/donutdrop/shared/secrets/api-bot-credentials.json
API_ADMIN_TOTP_SECRETS_JSON_FILE=/opt/donutdrop/shared/secrets/api-admin-totp-secrets.json
API_AUDIT_HMAC_KEY_FILE=/opt/donutdrop/shared/secrets/api-audit-hmac-key
API_IP_HASH_KEY_FILE=/opt/donutdrop/shared/secrets/api-ip-hash-key
API_DONUTSMP_API_KEY_FILE=/opt/donutdrop/shared/secrets/api-donutsmp-api-key
AUDIT_VERIFICATION_KEYS_JSON_FILE=/opt/donutdrop/shared/secrets/audit-verification-keys.json
AUDIT_CHECKPOINT_HMAC_KEY_FILE=/opt/donutdrop/shared/secrets/audit-checkpoint-hmac-key
BOT_WEBHOOK_SECRET_FILE=/opt/donutdrop/shared/secrets/bot-webhook-secret
BOT_AUTH_DIRECTORY=/opt/donutdrop/shared/minecraft-auth

EDGE_NETWORK_CIDR=172.30.0.0/24
DATABASE_NETWORK_CIDR=172.31.0.0/24
CACHE_NETWORK_CIDR=172.34.0.0/24
BOT_CONTROL_NETWORK_CIDR=172.32.0.0/24
BOT_EGRESS_NETWORK_CIDR=172.33.0.0/24
API_EGRESS_NETWORK_CIDR=172.36.0.0/24

# ─────────────── Discord control plane ───────────────
# The admin dashboard is reached through a one-time link minted by a Discord command, so the
# dashboard is only usable once this is on and the bot is running with `--profile discord`.
#
# DISCORD_OPERATORS_JSON is the allowlist that decides who may mint that link. It maps a Discord
# user id to the platform identity it acts as, and it is not set here: it lives in a secret file
# beside the token, because it decides who can become an administrator.
# Who is an administrator, independent of Discord. A Discord operator must ALSO be listed here
# or the gateway refuses to boot: a mapping in DISCORD_OPERATORS_JSON is permission to use an
# existing administrator identity, never permission to become one.
# Comma-separated `mc:<32 hex>` values.
ADMIN_MINECRAFT_IDS=

DISCORD_CONTROL_ENABLED=false
DISCORD_APPLICATION_ID=
DISCORD_GUILD_ID=
DISCORD_ALERT_CHANNEL_ID=
DISCORD_ADMIN_LINK_TTL_SECONDS=300
DISCORD_LOG_LEVEL=info

DISCORD_BOT_TOKEN_FILE=/opt/donutdrop/shared/secrets/discord-bot-token
DISCORD_CONTROL_HMAC_KEY_FILE=/opt/donutdrop/shared/secrets/discord-control-hmac-key
DISCORD_OPERATORS_JSON_FILE=/opt/donutdrop/shared/secrets/discord-operators.json

# ─────────────── Sign-in challenge (Cloudflare Turnstile) ───────────────
# The site key is public — it is rendered into the widget — and is served to the browser by
# GET /v1/auth/pay/turnstile. The secret key is not here: it lives in a secret file beside the
# others, because it is the half that proves a challenge was actually solved.
#
# Set both with: sudo ./infra/vps/set-turnstile.sh <site-key> <secret-key>
TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY_FILE=/opt/donutdrop/shared/secrets/turnstile-secret-key
